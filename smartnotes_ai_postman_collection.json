{
  "info": {
    "_postman_id": "b38f8319-86ab-472d-9af2-3e2b2a60bf99",
    "name": "SmartNotes AI - Complete REST API Collection",
    "description": "Production-grade Postman collection for SmartNotes AI Android App backend (PHP + MySQL on XAMPP).\nCovers Authentication, Profile, Notes CRUD, and Dashboard Stats.\nWorks with Android frontend (Emulator 10.0.2.2 or Physical Device LAN IP).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/ai_class_be",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "alex.morgan@campus.edu",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "note_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "description": "User registration, login, token issuance, password recovery, and session termination.",
      "item": [
        {
          "name": "1.1 Sign Up (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "}",
                  "if (jsonData.user_id) {",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.user_id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Alex Morgan\",\n  \"email\": \"alex.morgan@campus.edu\",\n  \"password\": \"studentSecret123!\",\n  \"confirmPassword\": \"studentSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup.php"]
            }
          }
        },
        {
          "name": "1.2 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.user.id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"studentSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "login.php"]
            }
          }
        },
        {
          "name": "1.3 Forgot Password (Request OTP / Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.reset_token) {",
                  "    pm.collectionVariables.set(\"reset_token\", jsonData.reset_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot_password.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot_password.php"]
            }
          }
        },
        {
          "name": "1.4 Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"studentSecret123!\",\n  \"confirm_password\": \"studentSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset_password.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset_password.php"]
            }
          }
        },
        {
          "name": "1.5 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout.php"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Student Profile",
      "description": "Onboarding profile creation, profile updates, and fetch profile.",
      "item": [
        {
          "name": "2.1 Add Profile (Onboarding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"selectedCourse\": \"B.Tech · Computer Science\",\n  \"selectedDepartment\": \"Computer Science & Engineering\",\n  \"selectedSemester\": \"Semester 7 · Final year\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/profile_add.php",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_add.php"]
            }
          }
        },
        {
          "name": "2.2 Edit Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Alex Morgan\",\n  \"course\": \"B.Tech · Computer Science\",\n  \"department\": \"Computer Science & Engineering\",\n  \"semester\": 7\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/profile_edit.php",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_edit.php"]
            }
          }
        },
        {
          "name": "2.3 Fetch Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile/profile_fetch.php?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_fetch.php"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Notes",
      "description": "Full CRUD operations for student lecture notes with filtering and search.",
      "item": [
        {
          "name": "3.1 List Notes (All)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes/list_notes.php?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["notes", "list_notes.php"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "3.2 Search Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes/list_notes.php?user_id={{user_id}}&search=normalization&category=Computer Science",
              "host": ["{{base_url}}"],
              "path": ["notes", "list_notes.php"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                },
                {
                  "key": "search",
                  "value": "normalization"
                },
                {
                  "key": "category",
                  "value": "Computer Science"
                }
              ]
            }
          }
        },
        {
          "name": "3.3 Get Note by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes/get_note.php?id={{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["notes", "get_note.php"],
              "query": [
                {
                  "key": "id",
                  "value": "{{note_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "3.4 Create / Save Note",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.note_id) {",
                  "    pm.collectionVariables.set(\"note_id\", jsonData.note_id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"title\": \"Distributed Systems: Raft Consensus Algorithm\",\n  \"subject\": \"Computer Science\",\n  \"courseCode\": \"CS401\",\n  \"summary\": \"Raft achieves consensus via leader election, log replication, and safety invariants.\",\n  \"keyTakeaways\": [\n    \"Leader election prevents split-brain anomalies.\",\n    \"Log matching ensures state machine replication consistency.\"\n  ],\n  \"importantTerms\": [\n    \"Leader Election\",\n    \"Heartbeat\",\n    \"Log Replication\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/notes/create_note.php",
              "host": ["{{base_url}}"],
              "path": ["notes", "create_note.php"]
            }
          }
        },
        {
          "name": "3.5 Update Note / Bookmark",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{note_id}},\n  \"isBookmarked\": true,\n  \"title\": \"Distributed Systems: Raft Consensus (Updated)\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/notes/update_note.php",
              "host": ["{{base_url}}"],
              "path": ["notes", "update_note.php"]
            }
          }
        },
        {
          "name": "3.6 Delete Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes/delete_note.php?id={{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["notes", "delete_note.php"],
              "query": [
                {
                  "key": "id",
                  "value": "{{note_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Dashboard",
      "description": "Calculates live statistics, total notes, subjects count, quizzes count, and recent notes.",
      "item": [
        {
          "name": "4.1 Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/dashboard_stats.php?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "dashboard_stats.php"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
