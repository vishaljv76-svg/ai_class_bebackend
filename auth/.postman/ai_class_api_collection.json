{
  "info": {
    "_postman_id": "a91b4562-b91a-47d2-9cf1-889fb314a921",
    "name": "SmartNotes AI - Backend Auth & Profile APIs",
    "description": "Collection for testing SmartNotes AI Android App backend APIs (Auth, Forgot Password, Reset Password, Onboarding, and Student Profile).\n\nCompatible with PHP backend at `c:\\xampp\\htdocs\\ai_class_be` and Android app UI screens (`ui.login`, `ui.signup`, `ui.forgotpassword`, `ui.onboarding`, `ui.profile`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/ai_class_be",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "2",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "alex.morgan@campus.edu",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "description": "APIs mapped directly to `SignupScreen`, `LoginScreen`, and `ForgotPasswordScreen`.",
      "item": [
        {
          "name": "1.1 Sign Up (Create Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.user_id) {",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.user_id);",
                  "}",
                  "if (jsonData.user && jsonData.user.email) {",
                  "    pm.collectionVariables.set(\"test_email\", jsonData.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Alex Morgan\",\n  \"email\": \"alex.morgan@campus.edu\",\n  \"password\": \"studentSecret123!\",\n  \"confirmPassword\": \"studentSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup.php"]
            },
            "description": "Registers a new user.\n\nMapped to: `ui/signup/SignupScreen.kt`\nAccepts both `name` and `studentName`, `confirm_password` and `confirmPassword`.\nReturns `user_id` and full `user` object with initials."
          },
          "response": []
        },
        {
          "name": "1.2 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.user.id);",
                  "    pm.collectionVariables.set(\"test_email\", jsonData.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"studentSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "login.php"]
            },
            "description": "Authenticates a student.\n\nMapped to: `ui/login/LoginScreen.kt`\nReturns user details (`id`, `name`, `email`, `initials`) and `has_profile` with profile details so the app knows whether to route to StudentOnboarding or HomeDashboard."
          },
          "response": []
        },
        {
          "name": "1.3 Forgot Password (Request Reset Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.reset_token) {",
                  "    pm.collectionVariables.set(\"reset_token\", jsonData.reset_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot_password.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot_password.php"]
            },
            "description": "Initiates password reset.\n\nMapped to: `ui/forgotpassword/ForgotPasswordScreen.kt`\nGenerates a 6-digit reset token valid for 30 minutes (matching the screen text: 'The reset link expires in 30 minutes'). In development/testing, returns `reset_token` in response for immediate use."
          },
          "response": []
        },
        {
          "name": "1.4 Reset Password (Set New Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"newSecurePass123!\",\n  \"confirm_password\": \"newSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset_password.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset_password.php"]
            },
            "description": "Completes password reset with the code generated from Forgot Password.\n\nVerifies the reset token, updates hashed password in database, and clears the token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Student Profile",
      "description": "APIs mapped directly to `StudentOnboardingScreen` and `ProfileSettingsScreen`.",
      "item": [
        {
          "name": "2.1 Add Profile (Onboarding Step 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"selectedCourse\": \"B.Tech · Computer Science\",\n  \"selectedDepartment\": \"Computer Science & Engineering\",\n  \"selectedSemester\": \"Semester 7 · Final year\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/profile_add.php",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_add.php"]
            },
            "description": "Saves student academic profile during onboarding.\n\nMapped to: `ui/onboarding/StudentOnboardingScreen.kt`\nAccepts both `userId`/`user_id`, `selectedCourse`/`course`, `selectedDepartment`/`department`, and string semester (e.g., 'Semester 7 · Final year') or int `7`.\nPerforms upsert so re-submitting won't fail with 409."
          },
          "response": []
        },
        {
          "name": "2.2 Edit Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"studentName\": \"Alex Morgan\",\n  \"course\": \"B.Tech · Computer Science\",\n  \"department\": \"Computer Science & Engineering\",\n  \"semester\": 7\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/profile_edit.php",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_edit.php"]
            },
            "description": "Edits existing student profile and name.\n\nMapped to: `ui/profile/ProfileSettingsScreen.kt`\nAllows updating academic details as well as student name."
          },
          "response": []
        },
        {
          "name": "2.3 Fetch Profile by User ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/profile_fetch.php?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_fetch.php"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Fetches user details and student academic profile.\n\nMapped to: `ui/profile/ProfileSettingsScreen.kt`\nReturns computed fields matching UI state: `initials`, `semester_badge`, and `year_badge`."
          },
          "response": []
        },
        {
          "name": "2.4 Fetch Profile by Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/profile_fetch.php?email={{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "profile_fetch.php"],
              "query": [
                {
                  "key": "email",
                  "value": "{{test_email}}"
                }
              ]
            },
            "description": "Fetches profile using email address instead of user_id."
          },
          "response": []
        }
      ]
    }
  ]
}

